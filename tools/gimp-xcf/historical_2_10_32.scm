; Original finite historical producer witness. No old implementation/asset copies.
(define (historical-2-10-32-author output-root facts-file)
  (let* ((name "historical-2-10-32-legacy-text-path")
         (xcf (string-append output-root "/" name ".xcf"))
         (png (string-append output-root "/" name ".png"))
         (image (car (gimp-image-new 64 32 RGB)))
         (text (car (gimp-text-layer-new image "Legacy XCF" "Sans-serif" 12 PIXELS)))
         (vectors (car (gimp-vectors-new image "Original legacy Bezier"))))
    (gimp-image-insert-layer image text 0 0)
    (gimp-layer-set-mode text 0)
    (gimp-layer-set-offsets text 0 0)
    (gimp-text-layer-set-color text '(0 0 0))
    (gimp-image-insert-vectors image vectors 0 0)
    (gimp-vectors-stroke-new-from-points vectors 0 12
      #(2.0 4.0 4.0 4.0 8.0 2.0 40.0 24.0 44.0 24.0 48.0 28.0) TRUE)
    (gimp-image-set-metadata image "")
    (gimp-xcf-save RUN-NONINTERACTIVE image text xcf xcf)
    (gimp-image-delete image)
    (let* ((loaded (car (gimp-file-load RUN-NONINTERACTIVE xcf xcf)))
           (layers (gimp-image-get-layers loaded))
           (paths (gimp-image-get-vectors loaded))
           (loaded-text (vector-ref (cadr layers) 0))
           (loaded-path (vector-ref (cadr paths) 0))
           (strokes (gimp-vectors-get-strokes loaded-path))
           (stroke-id (vector-ref (cadr strokes) 0)))
      (call-with-output-file facts-file
        (lambda (port)
          (write (list 'gimp-version (gimp-version)) port) (newline port)
          (write (list name (gimp-image-width loaded) (gimp-image-height loaded)
            (gimp-image-get-precision loaded) (gimp-text-layer-get-text loaded-text)
            (gimp-text-layer-get-font loaded-text) (gimp-text-layer-get-font-size loaded-text)
            (gimp-text-layer-get-color loaded-text) (gimp-drawable-offsets loaded-text)
            (gimp-vectors-stroke-get-points loaded-path stroke-id)) port) (newline port)))
      ; Preview only: crop/extend the reopened text raster to the document canvas.
      (gimp-layer-resize-to-image-size loaded-text)
      (gimp-image-set-metadata loaded "")
      (file-png-save RUN-NONINTERACTIVE loaded loaded-text png png
        0 9 0 0 0 0 0)
      (gimp-image-delete loaded)
      (gimp-message "Historical2.10.32 legacy text/path saved, deleted, reopened and exported"))))
