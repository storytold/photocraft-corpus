(define (historical-highdepth-readback xcf facts-file)
 (let* ((image (car (gimp-file-load RUN-NONINTERACTIVE xcf xcf)))
        (layers (gimp-image-get-layers image))
        (layer (vector-ref (cadr layers) 0)))
  (call-with-output-file facts-file
   (lambda (port)
    (write (list 'gimp-version (gimp-version)) port)(newline port)
    (write (list 'image (gimp-image-width image) (gimp-image-height image) (gimp-image-get-precision image)
      (gimp-layer-get-mode layer) (gimp-drawable-offsets layer)) port)(newline port)
    (let loopy ((y 0)) (if (< y 6) (begin
     (let loopx ((x 0)) (if (< x 8) (begin
      (write (list 'pixel x y (gimp-drawable-get-pixel layer x y)) port)(newline port)
      (loopx (+ x 1)))))
     (loopy (+ y 1)))))))
  (gimp-image-delete image)
  (gimp-message "SOL7_ALL_PUBLIC_PIXELS_OK")))

; Original tiny procedural pixels authored through public GIMP 2.9.6 PDB.
; No XCF input, version-byte replacement or private setter is used.
(define (historical-highdepth-case output-root name precision mode)
  (let* ((image (car (gimp-image-new 8 6 RGB)))
         (layer (car (gimp-layer-new image 8 6 RGBA-IMAGE "Original partial-alpha samples" 100 mode)))
         (xcf (string-append output-root "/" name ".xcf"))
         (png (string-append output-root "/" name ".png"))
         (facts (string-append output-root "/" name ".source-facts.scm")))
    (gimp-image-insert-layer image layer 0 0)
    (gimp-layer-set-mode layer mode)
    (let loopy ((y 0))
      (if (< y 6)
        (begin
          (let loopx ((x 0))
            (if (< x 8)
              (let ((pixel (cons-array 4 'byte)))
                (aset pixel 0 (modulo (+ (* x 23) 17) 256))
                (aset pixel 1 (modulo (+ (* y 37) 13) 256))
                (aset pixel 2 (modulo (+ (* x 11) (* y 19) 29) 256))
                (aset pixel 3 (+ 64 (* (modulo (+ x y) 4) 48)))
                (gimp-drawable-set-pixel layer x y 4 pixel)
                (loopx (+ x 1)))))
          (loopy (+ y 1)))))
    (gimp-image-convert-precision image precision)
    (gimp-image-set-metadata image "")
    (gimp-xcf-save RUN-NONINTERACTIVE image layer xcf xcf)
    (gimp-image-delete image)
    (let* ((loaded (car (gimp-file-load RUN-NONINTERACTIVE xcf xcf)))
           (layers (gimp-image-get-layers loaded))
           (owner (vector-ref (cadr layers) 0)))
      (call-with-output-file facts
        (lambda (port)
          (write (list 'gimp-version (gimp-version)) port) (newline port)
          (write (list name (gimp-image-width loaded) (gimp-image-height loaded)
            (gimp-image-get-precision loaded) (gimp-layer-get-mode owner)
            (gimp-drawable-width owner) (gimp-drawable-height owner) (gimp-drawable-offsets owner)
            (gimp-drawable-get-pixel owner 0 0)) port) (newline port)))
      (gimp-image-set-metadata loaded "")
      (file-png-save RUN-NONINTERACTIVE loaded owner png png 0 9 0 0 0 0 0)
      (gimp-image-delete loaded)
      (gimp-message (string-append "SOL7_GENUINE_HIGHDEPTH_OK " name)))))

; Original asymmetric U16 samples through the ordinary public pixel PDB.
(define (historical-asymmetric-case output-root name mode)
 (let* ((image (car (gimp-image-new 8 6 RGB)))
        (layer (car (gimp-layer-new image 8 6 RGBA-IMAGE "Original asymmetric U16 samples" 100 mode)))
        (xcf (string-append output-root "/" name ".xcf"))
        (png (string-append output-root "/" name ".png")))
  (gimp-image-insert-layer image layer 0 0)
  (gimp-layer-set-mode layer mode)
  (gimp-image-convert-precision image 250)
  (let loopy ((y 0)) (if (< y 6) (begin
   (let loopx ((x 0)) (if (< x 8)
    (let* ((pixel (cons-array 8 'byte))
           (values (vector (+ 4660 (* x 259) (* y 517)) (+ 13398 (* x 257) (* y 775))
                           (+ 30874 (* x 515) (* y 265)) (+ 16384 (* (modulo (+ x y) 4) 8192)))))
     (let channel ((k 0)) (if (< k 4) (begin
      (aset pixel (* k 2) (modulo (vector-ref values k) 256))
      (aset pixel (+ (* k 2) 1) (quotient (vector-ref values k) 256))
      (channel (+ k 1)))))
     (gimp-drawable-set-pixel layer x y 8 pixel)
     (loopx (+ x 1)))))
   (loopy (+ y 1)))))
  (gimp-image-set-metadata image "")
  (gimp-xcf-save RUN-NONINTERACTIVE image layer xcf xcf)
  (gimp-image-delete image)
  (historical-highdepth-readback xcf (string-append output-root "/" name ".all-pixels.scm"))
  (let* ((loaded (car (gimp-file-load RUN-NONINTERACTIVE xcf xcf)))
         (layers (gimp-image-get-layers loaded)) (owner (vector-ref (cadr layers) 0)))
   (gimp-image-set-metadata loaded "")
   (file-png-save RUN-NONINTERACTIVE loaded owner png png 0 9 0 0 0 0 0)
   (gimp-image-delete loaded))
  (gimp-message (string-append "SOL7_ASYMMETRIC_U16_OK " name))))

(define (historical-2-9-6-all output-root)
 (historical-asymmetric-case output-root "historical-2-9-6-v007-u16-asymmetric-rle" 0)
 (historical-highdepth-case output-root "historical-2-9-6-v007-float-rle" 650 0)
 (historical-highdepth-readback (string-append output-root "/historical-2-9-6-v007-float-rle.xcf") (string-append output-root "/historical-2-9-6-v007-float-rle.all-pixels.scm"))
 (historical-asymmetric-case output-root "historical-2-9-6-v009-u16-asymmetric-rle" 23)
 (historical-highdepth-case output-root "historical-2-9-6-v009-float-rle" 650 23)
 (historical-highdepth-readback (string-append output-root "/historical-2-9-6-v009-float-rle.xcf") (string-append output-root "/historical-2-9-6-v009-float-rle.all-pixels.scm"))
 (historical-asymmetric-case output-root "historical-2-9-6-v011-u16-asymmetric-rle" 28)
 (historical-highdepth-case output-root "historical-2-9-6-v011-float-rle" 650 28)
 (historical-highdepth-readback (string-append output-root "/historical-2-9-6-v011-float-rle.xcf") (string-append output-root "/historical-2-9-6-v011-float-rle.all-pixels.scm"))
)
